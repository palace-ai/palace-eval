  {
    "name": "MATH-500",
    "id": "HuggingFaceH4/MATH-500",
    "split": "test",
    "column_names": {
      "objective": "problem",
      "expected": "answer"
    },
    "category": "Mathematical Reasoning",
    "task_type": "QA",
    "custom_verificator": "def verify(pred, truth):\n    import re\n    numbers = re.findall(r'-?\\d+\\.?\\d*', pred.replace(',', ''))\n    if not numbers:\n        return pred.strip() == truth.strip()\n    try:\n        return abs(float(numbers[-1]) - float(truth)) < 1e-6\n    except ValueError:\n        return pred.strip() == truth.strip()"
  },
