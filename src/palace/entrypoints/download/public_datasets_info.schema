# JSON Schema Reference for public_datasets_info.json
# This file documents the format for adding public HuggingFace benchmarks.

[
    {
        # Required fields
        "name": "User-friendly benchmark name (used for folder and display)",
        "id": "Exact HuggingFace dataset ID (e.g., 'org/dataset-name')",
        "task_type": "QA | Classification | Report Generation",

        # Column mapping (required)
        "column_names": {
            "objective": "Column containing the task prompt/question (required)",
            "expected": "Column containing the expected answer (required for QA)",
            "id": "Column for task ID (optional, auto-generated if missing)",
            "difficulty": "Column for difficulty level (optional)",
            "attachment": "Column containing file attachment name or inline data (optional)"
        },

        # Dataset location (optional)
        "config": "HuggingFace config/subset name (default: 'default')",
        "split": "Dataset split: 'train', 'validation', 'test', or list of splits (default: 'test')",

        # Attachment handling (optional)
        "attachment_path": "Path prefix for attachment files in the HF repo (e.g., '2023/validation')",
        "inline_attachment": "true if attachment column contains file content (base64/text), not filenames",

        # Metadata (optional)
        "category": "Benchmark category (e.g., 'Safety', 'Agentic', 'Long Context')",

        # Task type configuration (optional, required for Classification)
        "task_type_fields": {
            # For QA:
            "correctness_criterion": {
                "name": "Criterion name",
                "description": "What makes an answer correct"
            },
            "references": {
                "correct": ["field_names_with_correct_answers"],
                "incorrect": ["field_names_with_incorrect_answers"]
            },

            # For Classification (required):
            "labels": [
                {
                    "name": "LabelName",
                    "description": "What this label measures",
                    "classes": [
                        {"name": "ClassName", "condition": "when to use this class"}
                    ]
                }
            ],

            # For Report Generation:
            "criteria": [
                {"name": "criterion_name", "description": "...", "weight": 1.0}
            ]
        },

        # Classification-specific (optional)
        "default_labels": {
            "LabelName": "DefaultClass"
        },
        # Use when all tasks have the same label (e.g., all-unsafe safety benchmark)

        # Answer transformation (optional)
        "label_mapping": {
            "ORIGINAL_VALUE": "mapped_value"
        },
        # Maps values in expected column to standardized values

        # Custom verification (optional)
        "custom_verificator": "def verify(pred, truth):\n    return pred == truth",
        # Python function for programmatic verification instead of LLM judge

        # Additional columns (optional)
        "keep_custom_columns": true
        # Preserve extra columns from source dataset in tasks.json
    }
]
