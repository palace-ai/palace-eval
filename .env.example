# =============================================================================
# PALACE Configuration
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
# =============================================================================


# =============================================================================
# REQUIRED
# =============================================================================

# OpenAI-compatible API endpoint and key.
# Used for both the model under evaluation AND the judge model.
# Command-line flags (-u/-k) override these for the evaluated model only.
OPENAI_LIKE_API_BASE_URL=https://api.openai.com/v1
OPENAI_LIKE_API_KEY=

# Model used as judge for answer verification.
# Must be available at the OPENAI_LIKE_API_BASE_URL endpoint.
# A sufficiently capable model is recommended.
JUDGE_MODEL=


# =============================================================================
# OPTIONAL
# =============================================================================

# Number of tasks evaluated concurrently. Higher = faster but more API load.
# Default: 25
PALACE_CONCURRENCY=25

# HuggingFace token for downloading gated datasets.
# Get one at: https://huggingface.co/settings/tokens
# Required for: GAIA, GPQA Diamond, SuperGPQA
# Not needed for: SimpleQA, HotpotQA, MMLU, BBH, IFEval, etc.
HUGGINGFACE_TOKEN=

# Vivarium URL for agentic evaluation.
# Leave empty to auto-start Vivarium locally (requires Docker).
# Set to a remote URL if running Vivarium as a separate service.
VIVARIUM_URL=

# Enable the citation verifier analyzer (experimental).
# Only relevant for report generation tasks.
ENABLE_CITATION_VERIFIER=False
