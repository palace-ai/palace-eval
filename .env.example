# =============================================================================
# PALACE Configuration
# =============================================================================
# This file contains all configurable environment variables for PALACE.
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Variables are organized into:
#   1. REQUIRED - You must set these before running PALACE
#   2. OPTIONAL - Tune evaluation behavior (sensible defaults provided)
#   3. INTERNAL - JRC infrastructure endpoints (leave empty if not at JRC)
# =============================================================================


# =============================================================================
# 1. REQUIRED — Set these before running PALACE
# =============================================================================

# OpenAI-compatible API endpoint and key.
# This is used for both the model under evaluation AND the judge model.
# If you use palace-run with -u/-k flags, those override these for the evaluated
# model, but the judge still uses these values.
OPENAI_LIKE_API_BASE_URL=https://your-api-endpoint.com/v1
OPENAI_LIKE_API_KEY=

# Model used as judge for answer verification. Must be available at the
# OPENAI_LIKE_API_BASE_URL endpoint above. Default: gpt-oss-120b
JUDGE_MODEL=gpt-oss-120b


# =============================================================================
# 2. OPTIONAL — Evaluation settings (defaults work out of the box)
# =============================================================================

# Number of tasks evaluated concurrently. Higher = faster but more API load.
# Default: 25
PALACE_CONCURRENCY=25

# Enable the citation verifier analyzer (checks if agent cites real sources).
# Only relevant for tasklists with report generation tasks. Default: False
# Analyzers are an experimental feature and not thoroughly tested. Use at your own risk.
ENABLE_CITATION_VERIFIER=False

# HuggingFace token for downloading gated/private datasets.
# Get one at: https://huggingface.co/settings/tokens
# Required for: GAIA, GPQA Diamond, SuperGPQA
# Not needed for: SimpleQA, HotpotQA, MMLU, BBH, IFEval, etc.
HUGGINGFACE_TOKEN=

# Vivarium URL for agentic evaluation (requires Docker).
# Leave empty unless you're running agentic benchmarks.
# See README section "Agentic evaluation" for setup.
VIVARIUM_URL=


# =============================================================================
# 3. INTERNAL — JRC infrastructure (leave empty if you're unsure)
# =============================================================================
# These configure JRC-internal services used by the interactive CLI (palace-cli)
# and the citation verifier's ALOHA fetch proxy. They are not needed for
# standard evaluation via palace-run or the programmatic API.

# ALOHA MCP proxy (alternative fetch path for DMZ environments)
USE_ALOHA=
ALOHA_WEB_URL=
ALOHA_WEB_TOKEN=
ALOHA_LITERATURE_URL=
ALOHA_LITERATURE_TOKEN=

# JRC staging endpoints (appear in palace-cli MCP server list)
ALOHA_STAGING_URL=
ALOHA_STAGING_TOKEN=
TS_STAGING_URL=
TS_STAGING_TOKEN=
ABW_SERVE_STAGING_URL=
