# =============================================================================
# PALACE Configuration
# =============================================================================
# 
# RECOMMENDED: Use 'palace config set' instead of this file:
#   palace config set url https://api.openai.com/v1
#   palace config set key sk-your-api-key
#   palace config set judge_model gpt-4o
#
# Environment variables are still supported for CI/Docker deployments.
# Priority: CLI flags > env vars > config file (~/.config/palace/config.yaml)
#
# =============================================================================


# =============================================================================
# API CONFIGURATION
# =============================================================================

# OpenAI-compatible API endpoint URL
# CLI equivalent: palace config set url <value>
OPENAI_LIKE_API_BASE_URL=https://api.openai.com/v1

# API key for the endpoint
# CLI equivalent: palace config set key <value>
OPENAI_LIKE_API_KEY=

# Model used as judge for answer verification
# CLI equivalent: palace config set judge_model <value>
JUDGE_MODEL=gpt-4o


# =============================================================================
# OPTIONAL
# =============================================================================

# Number of tasks evaluated concurrently (default: 25)
# CLI equivalent: palace config set concurrency <value>
PALACE_CONCURRENCY=25

# HuggingFace token for gated datasets (GAIA, GPQA Diamond, etc.)
# Get one at: https://huggingface.co/settings/tokens
# CLI equivalent: palace config set huggingface_token <value>
HUGGINGFACE_TOKEN=

# GitHub token for higher API rate limits when listing benchmarks
# CLI equivalent: palace config set github_token <value>
GITHUB_TOKEN=

# Vivarium URL for remote agentic evaluation
# Leave empty to auto-start Vivarium locally (requires Docker)
# CLI equivalent: palace config set vivarium_url <value>
VIVARIUM_URL=

# Enable the citation verifier analyzer (experimental)
ENABLE_CITATION_VERIFIER=False
